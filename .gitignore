# Secrets and sample data: nothing that looks like a credential ships, real
# or dummy. A demo password in a public repo is a real password to a scanner.
*.pem
*.key
*.jks
*.keystore
*.p12
key.properties
secrets.*
credentials.*
service-account*.json
google-services.json
GoogleService-Info.plist
**/*sample*.json
**/*seed*.json
**/*demo*.json
**/*fixture*.json

# Ensure source code under lib/ is never ignored by global gitignore (e.g. ~/.gitignore_global reports/)
!lib/features/reports/
!lib/features/reports/**
